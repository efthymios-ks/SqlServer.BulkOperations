<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>System.Data.SqlClient.BulkOperations.Benchmarks</AssemblyName>
		<RootNamespace>System.Data.SqlClient.BulkOperations.Benchmarks</RootNamespace>
		<IsPackable>false</IsPackable>

		<!-- BenchmarkDotNet needs an optimised build to produce meaningful numbers. -->
		<Optimize>true</Optimize>
		<ServerGarbageCollection>true</ServerGarbageCollection>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="BenchmarkDotNet" />
		<PackageReference Include="Microsoft.Data.SqlClient" />
		<PackageReference Include="Testcontainers.MsSql" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\System.Data.SqlClient.BulkOperations\Core.csproj" />
	</ItemGroup>
</Project>
